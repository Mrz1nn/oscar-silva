# Preencher quando a campanha tiver essas contas. Nenhuma delas é obrigatória
# para o site funcionar — sem elas, o rastreamento simplesmente não carrega.

# Google Analytics 4 — Measurement ID, formato G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Meta Pixel (Facebook/Instagram Ads) — ID numérico do pixel
NEXT_PUBLIC_META_PIXEL_ID=
